{
  "schemaVersion": 1,
  "name": "happy-memes",
  "displayName": "Happy Memes",
  "version": "0.1.1",
  "description": "Make funny, postable image memes about news, launches, trends, and everyday moments.",
  "compat": { "source": "native", "manifestDir": ".muse-plugin" },
  "capabilities": {
    "skills": [
      { "id": "meme", "path": "skills/meme/SKILL.md", "enabledDefault": true }
    ]
  }
}
